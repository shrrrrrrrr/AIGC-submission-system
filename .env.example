NODE_ENV=development
PORT=3000
SESSION_TTL_SECONDS=28800
DATABASE_URL=postgres://chinavr:change-me@127.0.0.1:5432/chinavr
# PostgreSQL 连接池参数；生产环境按独立数据库容量评估，不与其他项目共用配置。
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# 生产环境必须提供 32 字节密钥的 base64url 编码；不要提交真实密钥。
MFA_ENCRYPTION_KEY=
# 以逗号分隔的已批准平台根域名。程序只会展开代码中维护的第一方短链/移动端别名，
# 不会因为任意子域名看起来相似就自动放行。正式发布前仍应逐个平台实测公开链接。
APPROVED_VIDEO_PLATFORMS=douyin.com,iesdouyin.com,bilibili.com,b23.tv,xiaohongshu.com,xhslink.com,weixin.qq.com
# 生产环境使用阿里云 DirectMail API；缺少以下参数时生产启动会阻断。
MAILER_MODE=
MAILER_ACCESS_KEY_ID=
MAILER_ACCESS_KEY_SECRET=
MAILER_REGION=cn-hangzhou
MAILER_ENDPOINT=dm.aliyuncs.com
MAILER_FROM_ADDRESS=noreply@mail-test.otherworld-studio.cn
APP_PUBLIC_URL=https://submit.otherworld-studio.cn
# 可选：只有开启邮件跟踪时才配置。
MAILER_TAG_NAME=
# 仅用于本机 DirectMail 连通性冒烟测试，不会生成可用验证链接，不要写入生产配置。
# MAILER_TEST_RECIPIENT=shrbuaa@qq.com
